# Simulated backend (MSW REST + Socket.IO). Keep "true" for development, demo and E2E.
VITE_ENABLE_MOCKS=true
# Initial scenario(s), comma separated (see README › Cenários). Overridden by ?scenario=
VITE_MOCK_SCENARIO=default
# Floating scenario panel in the UI (hide per session with ?panel=off)
VITE_SHOW_SCENARIO_PANEL=true
# REST base path and Socket.IO origin (both intercepted by MSW)
VITE_API_BASE_URL=/api
# VITE_SOCKET_URL=https://example.com
# Session lifetime in minutes
VITE_SESSION_TTL_MINUTES=30
